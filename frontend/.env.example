# Copy to .env (or set in Vercel) - all optional in local dev:

# Deployed backend origin. Leave unset in dev (vite proxies /api to localhost:8080).
# VITE_API_URL=https://your-backend.onrender.com

# Supabase project credentials. When BOTH are set the app uses real Supabase
# auth; when unset it falls back to local dev-identity mode (X-Dev-User header).
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
